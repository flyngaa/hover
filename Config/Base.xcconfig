MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx

SWIFT_VERSION = 5.0
PRODUCT_NAME = Hover
PRODUCT_MODULE_NAME = HoverApp
PRODUCT_BUNDLE_IDENTIFIER = com.hover.desktop

GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Hover-Info.plist
CODE_SIGN_ENTITLEMENTS = Hover.entitlements
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
